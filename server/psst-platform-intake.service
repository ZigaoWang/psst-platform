[Unit]
Description=Psst platform reader intake (problem reports and demand)
After=network-online.target postgresql.service

[Service]
User=psst-platform
Group=psst-platform
EnvironmentFile=/www/wwwroot/psst-platform/env/api.env
ExecStart=/www/wwwroot/psst-platform/app/.venv/bin/psst system serve-intake
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
