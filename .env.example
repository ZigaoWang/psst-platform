# Copy to ~/.config/psst-platform/env (never into the repository) and fill in what this machine needs.

# The server, an entry in ~/.ssh/config. The CLI forwards the database and fetch service through it.
PSST_SSH_HOST=example-host

# Set on the server itself, where the database is reached directly instead of through SSH.
# PSST_DB_HOST=127.0.0.1
# PSST_DB_PORT=5432
PSST_DB_NAME=psst_platform

# One password per role this machine uses. Workers need only the worker password.
PSST_DB_PASSWORD_WORKER=change-me
# PSST_DB_PASSWORD_SYSTEM=change-me
# PSST_DB_PASSWORD_PUBLISHER=change-me
# PSST_DB_PASSWORD_ADMIN=change-me
