[Unit]
Description=Psst platform system worker (tool checks, place lookups, audit planning)
After=network-online.target postgresql.service

[Service]
User=psst-platform
Group=psst-platform
EnvironmentFile=/www/wwwroot/psst-platform/env/system.env
ExecStart=/www/wwwroot/psst-platform/app/.venv/bin/psst system work
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
