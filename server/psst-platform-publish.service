[Unit]
Description=Psst platform: carry out a publish or rollback asked for in the console
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=psst-platform
Group=psst-platform
EnvironmentFile=/www/wwwroot/psst-platform/env/publisher.env
ExecStart=/www/wwwroot/psst-platform/app/.venv/bin/psst publish-requests
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/www/wwwroot/psst-platform/public /www/wwwroot/psst-platform/app/work
